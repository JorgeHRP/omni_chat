OMNI_API_KEY=
OMNI_API_SECRET=
OMNI_CHATS_API_BASE=https://api.omni.chat/v1
OMNI_TAG_LABEL_ID=
OMNI_TAG_LABEL_NAME=Lead qualificado
# Link direto pra conversa no painel do Omni ({chat_id} = objectId do chat)
OMNI_CHAT_URL_TEMPLATE=https://app.omni.chat/#/home/chat/{chat_id}
OMNI_HISTORY_MESSAGE_LIMIT=300

RD_CRM_API_BASE=https://crm.rdstation.com/api/v1
RD_CRM_TOKEN=
RD_CRM_USER_ID=
RD_CRM_DEAL_STAGE_ID_LEAD=
# Funil "3.Comercial Brasil"
RD_CRM_DEAL_PIPELINE_ID=692f81682d85a9001e8b504e
# Fonte "Marketing - Whatsapp Omni"
RD_CRM_DEAL_SOURCE_ID=608b18cdf59636001b59280e
# Campo da empresa "Documento Fiscal (CNPJ, CPF...)"
RD_CRM_ORG_TAX_DOC_FIELD_ID=5fd26d3e5cc1db00123f7dcd
RD_CRM_ANNOTATION_MAX_CHARS=15000

# Cadencia de WhatsApp (etapas T1/T3/T4 CONTATO -> template do Omni). Deixe
# false ate testar com POST /cadence/test?step=T1&phone=... no seu numero.
CADENCE_WHATSAPP_ENABLED=false
# etapa_id:campanha_omni_id,... (padrao ja aponta pras campanhas T1/T3/T4)
# CADENCE_STAGE_CAMPAIGNS=6a16c675ada558002202465b:hZ24VxW1wS,6a16c69715fbf90021c23be0:KPG4dpM3q3,6a1f5bfd5c7da5001d843a5c:kKI1Z6sq3E
CADENCE_MAX_SENDS_PER_RUN=50
# Passa a conversa pra carteira do dono da negociacao no Omni (padrao true)
CADENCE_ROUTE_TO_OWNER=true

POLL_INTERVAL_MINUTES=10
INITIAL_LOOKBACK_HOURS=2
MAX_PAGES_PER_RUN=20

# Persistencia no Supabase (producao). Vazio = SQLite em data/.
# Tabelas: rode supabase_schema.sql no SQL Editor. Use a chave service_role.
SUPABASE_URL=
SUPABASE_KEY=
